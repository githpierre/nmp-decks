<div class="body" style="display:block"><div class="sh">{% set mx = s.years | map(attribute='n') | max %}
<div class="lg" style="position:absolute;left:0;top:0"><span><i style="background:#FB0161;border-radius:50%"></i>{{ s.on }}</span><span><i style="background:#1C4A60;border-radius:50%"></i>all rounds that year</span></div>
{% for y in s.years %}{% set R = 64 * (y.n / mx) ** 0.5 %}{% set r = R * (y.k / y.n) ** 0.5 %}<div style="position:absolute;left:{{ loop.index0 * 150 }}px;top:50px;width:136px;text-align:center">
 <svg width="136" height="140" viewBox="0 0 136 140"><circle cx="68" cy="{{ 136 - R }}" r="{{ R }}" fill="#1C4A60"/><circle cx="68" cy="{{ 136 - r }}" r="{{ r }}" fill="#FB0161"/></svg>
 <div class="pc" style="margin-top:6px">{{ y.p }}%</div><div class="yr">{{ y.x }}</div><div class="sub">{{ y.k }} of {{ y.n }} rounds</div></div>{% endfor %}
{% include 'slides/share_side.j2' %}</div></div>
