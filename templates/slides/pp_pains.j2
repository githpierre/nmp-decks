{% set G = s.geo %}{% for a in s.auds2 %}<span class="pp-ph" style="left:{{G.xs[loop.index0]}}px;top:{{G.head}}px">{{a[0]}}<br>{{a[1]}}</span>{% endfor %}
{% for r in G.rows %}<p class="pp-pt" style="top:{{r.y}}px">{{r.text}}</p><i class="pp-pl" style="top:{{r.y}}px;left:{{G.xs[0]}}px;width:{{G.xs[-1]-G.xs[0]}}px"></i>
{% for d in r.d %}<i class="pp-pd d{{d}}" style="left:{{G.xs[loop.index0]}}px;top:{{r.y}}px"></i>{% endfor %}{% endfor %}
