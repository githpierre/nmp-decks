<div class="body" style="display:block"><div class="sh">{% set last = s.years[-1] %}{% set pm = s.years | map(attribute='p') | max %}
<div style="position:absolute;left:30px;top:20px;width:380px"><div style="font-size:96pt;font-weight:700;line-height:.9;color:#FB0161">{{ last.p }}%</div>
 <div style="font-size:12pt;margin-top:14px;line-height:1.4">{{ s.what }}</div><div class="sub" style="margin-top:6px">{{ last.k }} of {{ last.n }} rounds, {{ last.x }}</div>
 <div style="display:flex;gap:26px;align-items:flex-end;height:120px;margin-top:26px">{% for y in s.years %}<div style="text-align:center"><div class="sub" style="color:#fff;font-weight:600">{{ y.p }}%</div><div style="width:44px;height:{{ (90 * y.p / pm) | round }}px;background:{{ '#FB0161' if loop.last else '#789096' }};border-radius:3px 3px 0 0;margin-top:4px"></div><div class="sub" style="margin-top:6px">{{ y.x }}</div></div>{% endfor %}</div></div>
<div style="position:absolute;left:470px;top:20px;width:400px;border-left:1.5px dashed #334D54;padding-left:30px"><div class="k" style="font-size:8pt;letter-spacing:.32em;margin-bottom:14px">{{ s.kicker | default('THE STORY BEHIND IT') }}</div>{% for p in s.story.split('\n') if p.strip() %}<p style="font-size:10pt;line-height:1.5;color:#A9B8BE;margin:0 0 12px">{{ p }}</p>{% endfor %}</div></div></div>
