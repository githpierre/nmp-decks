<div class="body"><div class="sx" style="flex-direction:column;align-items:center">
<div style="font-size:15pt;line-height:1.4;text-align:center;width:640px">{{ s.headline }}</div>
<div style="display:flex;margin-top:30px;border-top:1.5px solid #334D54;border-bottom:1.5px solid #334D54">{% for st in s.stats %}<div style="width:220px;padding:22px 16px;text-align:center;{% if not loop.last %}border-right:1.5px dashed #334D54{% endif %}"><div style="font-size:30pt;font-weight:700;line-height:1">{{ st.v }}</div><div class="sub" style="margin-top:8px;font-size:8.5pt;line-height:1.4">{{ st.l }}</div></div>{% endfor %}</div>
<p style="width:620px;text-align:center;font-size:9pt;line-height:1.5;color:#A9B8BE;margin:20px 0 0">{{ s.story }}</p></div></div>
