<div class="body"><div class="sx"><div class="chart" style="width:{{ s.chart_w | default(400) }}px">
<div class="lg">{% for g in s.groups %}<span><i style="background:{{ g.col }}"></i>{{ g.name }}</span>{% endfor %}</div>
{% for row in s.rows %}<div style="margin:{{ '0' if loop.first else '26px' }} 0 0"><div style="display:flex;justify-content:space-between"><span class="lab" style="font-weight:600">{{ row.name }}</span><span class="sub">{{ row.total }}</span></div>
<div style="display:flex;height:40px;margin-top:8px;border-radius:4px;overflow:hidden">{% for v in row.v %}<div style="width:{{ v }}%;background:{{ s.groups[loop.index0].col }};display:flex;align-items:center;justify-content:center;font-size:{{ 11 if v > 12 else 7 }}pt;font-weight:700;color:{{ '#062A3C' if s.groups[loop.index0].col in ('#FFFFFF', '#7FA9C9') else '#fff' }}">{% if v >= 8 %}{{ v }}%{% endif %}</div>{% endfor %}</div></div>{% endfor %}
</div>{% include 'slides/sx_side.j2' %}</div></div>
