{% set G = s.geo %}<div class="pp-stat">{{G.stat}}<span>{% if G.stat_text is string %}{{G.stat_text|safe}}{% else %}{% for l in G.stat_text %}{{l}}{% if not loop.last %}<br>{% endif %}{% endfor %}{% endif %}</span></div>
<p class="pp-expl"><b>{{s.date}}</b> {{s.expl}}</p>
<svg class="pp-abs" width="960" height="672">{% if G.ghost %}<polyline points="{{G.ghost}}" fill="none" stroke="#5E7E8E" stroke-width="2.5" stroke-dasharray="5 5" stroke-linejoin="round"/>{% if s.ghost_label %}<text x="{{s.ghost_x|default(560)}}" y="{{s.ghost_y|default(300)}}" fill="#8FA6B2" font-size="12">{{s.ghost_label}}</text>{% endif %}{% endif %}<polyline points="{{G.pts}}" fill="none" stroke="#FB0161" stroke-width="4" stroke-linejoin="round" stroke-linecap="round"/>{% if G.dash %}<polyline points="{{G.dash}}" fill="none" stroke="#789096" stroke-width="3" stroke-dasharray="7 7" stroke-linejoin="round" stroke-linecap="round"/>{% endif %}<line x1="134" y1="{{G.base}}" x2="826" y2="{{G.base}}" stroke="#5E7E8E"/></svg>
{% if G.dash %}<span class="pp-dashcap" style="right:{{960 - G.dash_x + 16}}px;top:{{G.dash_top}}px">{% for l in s.dash_caption %}{{l}}{% if not loop.last %}<br>{% endif %}{% endfor %}</span>{% endif %}
<span class="pp-tcap" style="top:{{G.base+14}}px">Worldwide Google searches for ‘{{s.term}}’, {{ s.period or s.caption_period or ('last twelve months' if s.window == '1y' else 'last five years') }}</span>
