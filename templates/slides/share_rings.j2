<div class="body" style="display:block"><div class="sh">
{% for y in s.years %}{% set r = 50 %}{% set c = 2 * 3.14159 * r %}<div style="position:absolute;left:{{ loop.index0 * 150 }}px;top:62px;width:136px;text-align:center">
 <svg width="136" height="136" viewBox="0 0 136 136"><circle cx="68" cy="68" r="{{ r }}" fill="none" stroke="#1C4A60" stroke-width="14"/><circle cx="68" cy="68" r="{{ r }}" fill="none" stroke="#FB0161" stroke-width="14" stroke-linecap="round" stroke-dasharray="{{ c * y.p / 100 }} {{ c }}" transform="rotate(-90 68 68)"/>
 <text x="68" y="75" text-anchor="middle" fill="#fff" font-size="22" font-weight="700" font-family="Lexend">{{ y.p }}%</text></svg>
 <div class="yr" style="margin-top:8px">{{ y.x }}</div><div class="sub" style="margin-top:4px">{{ y.k }} of {{ y.n }} rounds {{ s.what_short }}</div></div>{% endfor %}
{% include 'slides/share_side.j2' %}</div></div>
