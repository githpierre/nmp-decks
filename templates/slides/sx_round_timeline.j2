<div class="body"><div class="sx" style="flex-direction:column">{% set W = 720 %}{% set t0 = s.t0 %}{% set t1 = s.t1 %}{% set mx = s.amax %}
{% if s.legend %}<div class="lg" style="justify-content:center">{% for g in s.groups %}<span><i style="background:{{ g.col }};border-radius:50%"></i>{{ g.name }}</span>{% endfor %}<span>circle size = amount raised</span></div>{% endif %}
<svg class="rtl" width="760" height="230" viewBox="0 -20 760 230"><line x1="20" y1="150" x2="740" y2="150" stroke="#789096"/>
{% for y in s.ticks %}{% set x = 20 + W * (y.t - t0) / (t1 - t0) %}<line x1="{{ x }}" y1="146" x2="{{ x }}" y2="154" stroke="#789096"/><text x="{{ x }}" y="172" text-anchor="middle" fill="#fff" font-size="10" font-family="Lexend" font-weight="600">{{ y.l | upper }}</text>{% endfor %}
{% for r in s.pts %}{% set x = 20 + W * (r.t - t0) / (t1 - t0) %}{% set rr = 4 + 34 * (r.a / mx) ** 0.5 if r.a else 4 %}<circle data-i="{{ loop.index0 }}" cx="{{ x }}" cy="{{ r.cy if r.cy is defined else 150 - rr }}" r="{{ rr }}" fill="{{ r.col }}" fill-opacity="{{ 0.9 if r.a else 1 }}" stroke="#062A3C" stroke-width="1.2"/>{% endfor %}{% for r in s.pts if r.lab %}{% set x = 20 + W * (r.t - t0) / (t1 - t0) %}{% set rr = 4 + 34 * (r.a / mx) ** 0.5 %}<text class="rtl-lab" data-i="{{ s.pts.index(r) }}" data-cx="{{ x }}" data-cy="{{ r.cy }}" data-r="{{ rr }}" x="{{ x }}" y="{{ r.cy - rr - 6 }}" text-anchor="middle" fill="#fff" font-size="9.5" font-weight="600" font-family="Lexend" stroke="#062A3C" stroke-width="3" paint-order="stroke">{{ r.lab }}</text>{% endfor %}</svg>
<script>/* labels never sit on a bubble or on another label (Pierre, 12 Nov 2026): try above, higher, right, left, below, keep the first free spot */
(()=>{const sv=document.currentScript.previousElementSibling;const C=[...sv.querySelectorAll('circle')].map(c=>({i:c.dataset.i,x:+c.getAttribute('cx'),y:+c.getAttribute('cy'),r:+c.getAttribute('r')}));const placed=[];
const hit=(b,i)=>C.some(c=>c.i!==i&&Math.max(b.x,Math.min(c.x,b.x+b.width))-c.x<=c.r+1.5&&(()=>{const nx=Math.max(b.x,Math.min(c.x,b.x+b.width)),ny=Math.max(b.y,Math.min(c.y,b.y+b.height));return (nx-c.x)**2+(ny-c.y)**2<(c.r+1.5)**2})())||placed.some(p=>b.x<p.x+p.width+3&&p.x<b.x+b.width+3&&b.y<p.y+p.height+1&&p.y<b.y+b.height+1)||b.x<0||b.x+b.width>760||b.y<-20;
sv.querySelectorAll('.rtl-lab').forEach(t=>{const x=+t.dataset.cx,y=+t.dataset.cy,r=+t.dataset.r,i=t.dataset.i;const opts=[[x,y-r-6,'middle'],[x,y-r-18,'middle'],[x,y-r-30,'middle'],[x+r+4,y+3,'start'],[x-r-4,y+3,'end'],[x+r+4,y-r,'start'],[x-r-4,y-r,'end'],[x,y-r-42,'middle']];let best=null;for(const [a,b,an] of opts){t.setAttribute('x',a);t.setAttribute('y',b);t.setAttribute('text-anchor',an);const bb=t.getBBox();if(!hit(bb,i)){best=1;break}}if(!best){t.setAttribute('x',x);t.setAttribute('y',y-r-6);t.setAttribute('text-anchor','middle');t.dataset.clash=1}placed.push(t.getBBox());});})();</script>
<p style="text-align:center;font-size:9pt;line-height:1.5;color:#A9B8BE;margin:10px auto 0;width:620px">{{ s.story }}</p></div></div>
