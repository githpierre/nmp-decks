{# regions: na, eu, apac, mea, latam -> pct + text. Dot diameter = 0.89 px per % (min 5). Lines are drawn after layout (script below):
   they start just under (or above) the region text, always inclined, and stop at the dot. #}
{% set P = {'na':{'dot':[331,367],'box':[24,177,246],'name':'NORTH AMERICA'},
            'eu':{'dot':[493,359],'box':[396,177,313],'name':'EUROPE'},
            'apac':{'dot':[632,403],'box':[730,272,190],'name':'ASIA-PACIFIC'},
            'mea':{'dot':[529,396],'box':[440,500,290],'name':'MIDDLE EAST & AFRICA'},
            'latam':{'dot':[412,444],'box':[31,459,280],'name':'LATIN AMERICA'}} %}
<div class="map"><img class="w" src="../../assets/img/world-map.svg">
<svg class="lines" viewBox="0 0 960 672"><g stroke="#789096" stroke-width="1" stroke-dasharray="4 4" fill="none"></g></svg>
{% for k,r in s.regions.items() %}{% set d = [r.pct * 0.89, 5] | max %}
<div class="dot" data-k="{{ k }}" style="left:{{ P[k].dot[0] - d/2 }}px;top:{{ P[k].dot[1] - d/2 }}px;width:{{ d }}px;height:{{ d }}px"></div>
<div class="reg" data-k="{{ k }}" style="left:{{ P[k].box[0] }}px;top:{{ P[k].box[1] }}px;width:{{ s.widths[k] if s.widths and s.widths[k] else P[k].box[2] }}px"><h4>{{ r.name or P[k].name }} - {{ r.pct }}%</h4><p>{{ r.text | md }}</p></div>{% endfor %}
<script>
(() => { const map = document.currentScript.parentElement, S = map.closest('.slide').getBoundingClientRect(), g = map.querySelector('svg.lines g');
  const style = '{{ s.curve or "elbow" }}';
  map.querySelectorAll('.reg').forEach(reg => {
    const dot = map.querySelector('.dot[data-k="' + reg.dataset.k + '"]'); if (!dot) return;
    const d = dot.getBoundingClientRect(), cx = d.left + d.width / 2 - S.left, cy = d.top + d.height / 2 - S.top, rad = d.width / 2;
    const p = reg.querySelector('p'), h = reg.querySelector('h4');
    const rg = document.createRange(); rg.selectNodeContents(p);
    const lines = [...rg.getClientRects()].map(r => ({l: r.left - S.left, r: r.right - S.left, t: r.top - S.top, b: r.bottom - S.top}));
    const hb = h.getBoundingClientRect(), top = hb.top - S.top, bot = lines[lines.length - 1].b;
    const left = Math.min(...lines.map(x => x.l)), right = Math.max(...lines.map(x => x.r));
    // start: almost touching the text (4 px); end: on the dot's axis, 3 px from its edge (Pierre, workshop 5)
    let sx, sy, side = null;
    const clampIn = (x, a, b) => Math.max(a, Math.min(b, x));
    const pickX = (a, b) => {           // a point of [a, b] at least 45 px away from the dot horizontally, as close to it as possible
      const c = [cx - 45, cx + 45].map(x => clampIn(x, a, b)).filter(x => Math.abs(x - cx) >= 44);
      return c.length ? c.sort((u, v) => Math.abs(u - cx) - Math.abs(v - cx))[0] : (Math.abs(a - cx) > Math.abs(b - cx) ? a : b);
    };
    if (cy > bot + 20) {                // 1. dot under the text: leave just under the last line
      const ln = lines[lines.length - 1]; sy = bot + 4; sx = pickX(ln.l + 8, ln.r - 8);
    } else if (cy < top - 20 && cx > left - 30 && cx < right + 30) {   // 2. dot above: leave just above the title
      sy = top - 4; sx = pickX(hb.left - S.left + 8, hb.right - S.left - 8);
    } else {                            // 3. dot beside: leave from the side of the middle line of the text
      const ln = lines[Math.floor((lines.length - 1) / 2)];
      side = cx > (left + right) / 2 ? 1 : -1; sx = side > 0 ? ln.r + 4 : ln.l - 4; sy = (ln.t + ln.b) / 2;
    }
    let path, ex, ey;
    if (style === 's' || style === 's-dot' || style === 's-solid' || style === 'arc' || style === 'soft') {   // older shapes, kept for workshops
      const ang = Math.atan2(cy - sy, cx - sx); ex = cx - Math.cos(ang) * (rad + 3); ey = cy - Math.sin(ang) * (rad + 3);
      if (style === 'arc' || style === 'soft') { const mx = (sx + ex) / 2, my = (sy + ey) / 2, dx = ex - sx, dy = ey - sy, k = style === 'soft' ? 0.1 : 0.22; path = `M${sx} ${sy} Q${mx - dy * k} ${my + dx * k} ${ex} ${ey}`; }
      else path = side ? `M${sx} ${sy} C${sx + side * 60} ${sy} ${ex} ${(sy + ey) / 2} ${ex} ${ey}` : `M${sx} ${sy} C${sx} ${(sy + ey) / 2} ${ex} ${(sy + ey) / 2} ${ex} ${ey}`;
    } else if (side && Math.abs(cy - sy) < 24) {   // dot level with the text: short horizontal curve onto the dot's side
      ex = cx - side * (rad + 3); ey = cy; path = `M${sx} ${sy} Q${(sx + ex) / 2} ${sy} ${ex} ${ey}`;
    } else if (side) {                  // elbow (default): leaves horizontally, arrives vertically on the dot's axis
      ex = cx; ey = cy + (sy < cy ? -(rad + 3) : rad + 3); path = `M${sx} ${sy} Q${cx} ${sy} ${ex} ${ey}`;
    } else {                            // elbow (default): leaves vertically, arrives horizontally on the dot's axis
      ex = cx + (sx < cx ? -(rad + 3) : rad + 3); ey = cy; path = `M${sx} ${sy} Q${sx} ${cy} ${ex} ${ey}`;
    }
    const el = document.createElementNS('http://www.w3.org/2000/svg', 'path'); el.setAttribute('d', path); g.appendChild(el);
    if (style === 's-solid') { el.setAttribute('stroke-dasharray', 'none'); el.setAttribute('stroke-opacity', '.8'); }
    if (style === 's-dot') { const c = document.createElementNS('http://www.w3.org/2000/svg', 'circle'); c.setAttribute('cx', sx); c.setAttribute('cy', sy); c.setAttribute('r', 2.6);
      c.setAttribute('fill', '#789096'); c.setAttribute('stroke', 'none'); g.appendChild(c); }
  });
})();
</script>
</div>
