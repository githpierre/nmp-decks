<div class="body" style="display:block"><div class="sh">
{% for y in s.years %}{% set r = 56 %}{% set c = 3.14159 * r %}<div style="position:absolute;left:{{ loop.index0 * 152 }}px;top:92px;width:140px;text-align:center">
 <svg width="140" height="84" viewBox="0 0 140 84"><path d="M14 76 A56 56 0 0 1 126 76" fill="none" stroke="#1C4A60" stroke-width="15"/><path d="M14 76 A56 56 0 0 1 126 76" fill="none" stroke="#FB0161" stroke-width="15" stroke-dasharray="{{ c * y.p / 100 }} {{ c }}"/>
 <text x="70" y="72" text-anchor="middle" fill="#fff" font-size="20" font-weight="700" font-family="Lexend">{{ y.p }}%</text></svg>
 <div class="yr" style="margin-top:10px">{{ y.x }}</div><div class="sub" style="margin-top:4px">{{ y.k }} of {{ y.n }} rounds</div></div>{% endfor %}
{% include 'slides/share_side.j2' %}</div></div>
