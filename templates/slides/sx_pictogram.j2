<div class="body"><div class="sx" style="flex-direction:column;align-items:center">
<div style="display:flex;gap:14px">{% for i in range(s.n) %}<svg width="58" height="74" viewBox="0 0 58 74"><rect x="2" y="2" width="54" height="70" rx="8" fill="{{ '#FB0161' if i < s.k else '#1C4A60' }}"/><text x="29" y="44" text-anchor="middle" fill="#fff" font-size="15" font-weight="700" font-family="Lexend">{{ s.marks[i] if s.marks else '' }}</text></svg>{% endfor %}</div>
<div style="display:flex;gap:14px;margin-top:6px">{% for i in range(s.n) %}<div style="width:58px;text-align:center;font-size:6.5pt;color:#A9B8BE;line-height:1.25">{{ s.names[i] }}</div>{% endfor %}</div>
<div style="font-size:30pt;font-weight:700;margin-top:24px">{{ s.big }}</div><div class="lab" style="margin-top:4px">{{ s.what }}</div>
<p style="width:620px;text-align:center;font-size:9pt;line-height:1.5;color:#A9B8BE;margin:16px 0 0">{{ s.story }}</p></div></div>
