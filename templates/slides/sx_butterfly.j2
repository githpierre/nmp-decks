<div class="body"><div class="sx"><div class="chart">{% set mx = s.max %}
<div style="display:grid;grid-template-columns:1fr 70px 1fr;align-items:center;row-gap:16px">
 <div class="lab" style="text-align:right;font-weight:600;padding-right:6px">{{ s.left }}</div><div></div><div class="lab" style="font-weight:600;padding-left:6px">{{ s.right }}</div>
 {% for r in s.rows %}<div style="display:flex;justify-content:flex-end;align-items:center;gap:6px"><span class="lab" style="font-weight:700">{{ r.l }}</span><div style="height:30px;width:{{ 150 * r.l / mx }}px;background:#FB0161;border-radius:4px 0 0 4px"></div></div>
 <div style="text-align:center;font-weight:600;font-size:10pt">{{ r.x }}</div>
 <div style="display:flex;align-items:center;gap:6px"><div style="height:30px;width:{{ 150 * r.r / mx }}px;background:#789096;border-radius:0 4px 4px 0"></div><span class="lab" style="font-weight:700">{{ r.r }}</span></div>{% endfor %}</div>
<div class="sub" style="text-align:center;margin-top:12px">{{ s.unit }}</div></div>{% include 'slides/sx_side.j2' %}</div></div>
