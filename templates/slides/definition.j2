{# Pierre's design: framed sentence with two icons (workshop 5: all other designs rejected) #}
{% set v = s.variant or 'd1' %}
{% if v == 'd1' %}
<div class="body">
<svg class="dash-arrows" viewBox="0 0 880 410" style="position:absolute;inset:0;width:100%;height:100%">
  <g stroke="#334D54" stroke-width="1.5" stroke-dasharray="5 5" fill="none"><path d="M440 10 V60"/><path d="M440 400 V350"/><path d="M40 205 H100"/><path d="M840 205 H780"/></g>
</svg>
<div class="card defbox"><span class="ico tl">{{ s.icon_tl or '🎓' }}</span>{{ s.text }}<span class="ico br">{{ s.icon_br or '✅' }}</span></div>
</div>
{% endif %}
