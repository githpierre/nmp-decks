<!doctype html><html lang="en"><head><meta charset="utf-8"><title>{{ deck.market }} - {{ deck.quarter }}</title>
<link rel="stylesheet" href="../../css/nmp.css"></head><body>
{% for s in slides %}{% set T = s.type %}
{% if T == 'cover' %}{% include 'slides/cover.j2' %}{% else %}
<section class="slide {{ 'has-sub' if s.subtitle or (s.page and s.page != '1/1') }}" data-n="{{ loop.index }}"{% if s.id %} data-id="{{ s.id }}"{% endif %} data-type="{{ 'raw' if T.startswith('x/') else T }}"{% if T.startswith('x/') %} data-tpl="{{ T[2:] }}"{% endif %}{% if s.hl %} data-hl="{{ s.hl }}"{% endif %}{% if s.vbars %} data-vbars="{{ s.vbars | join(',') }}"{% endif %}>
  <div class="tri"></div>
  {% if s.section %}<div class="section">{{ s.section }}</div>{% endif %}
  {% if s.title %}<h1 class="title">{{ s.title | nl }}</h1>{% endif %}
  {% if s.subtitle or (s.page and s.page != '1/1') %}<div class="subtitle">{{ s.subtitle or s.page }}</div>{% endif %}
  {% if s.pill %}<div class="pillrow"><span class="pill">{{ s.pill }}</span></div>{% endif %}
  {% include 'slides/' ~ T ~ '.j2' %}
  {% if s.note %}{% if s.note is string %}<p class="note">{{ s.note | md }}</p>{% else %}<p class="note lines">{% for l in s.note %}<span class="nl">{{ l | md }}</span>{% endfor %}</p>{% endif %}{% endif %}
  {% if s.tag %}<div class="wtag">{{ s.tag }}</div>{% endif %}
  <div class="foot-line"></div><div class="foot-label">{{ s.label or deck.label }}</div><div class="foot-brand">NEWMARKETPITCH.COM</div>
</section>{% endif %}
{% endfor %}<script>/* Titles on 2 lines: cut where the two lines are the most equal in width (Pierre's rule, 31 Oct + 10 Nov 2026).
   The manual \n in deck.yaml is ignored: every split is measured and the smallest difference wins. */
(() => { const m = document.createElement('span'); m.style.cssText = 'position:absolute;white-space:nowrap;visibility:hidden;left:-9999px'; document.body.appendChild(m);
  const esc = s => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');   // words joined by a non-breaking space stay together
  document.querySelectorAll('.slide .title').forEach(t => {
    const cs = getComputedStyle(t); m.style.font = cs.font; m.style.letterSpacing = cs.letterSpacing; m.style.textTransform = cs.textTransform;
    const w = s => { m.textContent = s; return m.getBoundingClientRect().width; };
    const words = t.innerHTML.replace(/<br\s*\/?>/g, ' ').replace(/<[^>]+>/g, '').replace(/&amp;/g, '&').replace(/&nbsp;/g, '\u00a0').replace(/[ \t\n\r]+/g, ' ').trim().split(' ');
    const max = t.clientWidth, manual = /<br/.test(t.innerHTML); if (words.length < 2 || (!manual && w(words.join(' ')) <= max * 0.62)) return;   // short titles stay on one line unless written on two
    let best = null;
    for (let i = 1; i < words.length; i++) { const a = words.slice(0, i).join(' '), b = words.slice(i).join(' '), wa = w(a), wb = w(b);
      if (wa > max || wb > max) continue; if (/^(a|an|the|its|their|of|to|for|in|with|by|on|at|and|or|every)$/i.test(words[i - 1])) continue;   // 11 Nov: a line never ends on a small word
      const d = Math.abs(wa - wb); if (!best || d < best.d) best = {a, b, d, wa, wb}; }
    if (best) { t.innerHTML = esc(best.a) + '<br>' + esc(best.b); t.dataset.bal = Math.round(best.d / Math.max(best.wa, best.wb) * 100); }
  });
  // footer label on one line inside its 228 px: tighten the letter spacing if a long market name would overflow
  document.querySelectorAll('.foot-label').forEach(f => { let ls = 0.42; while (f.scrollWidth > f.clientWidth + 1 && ls > 0.1) { ls -= 0.02; f.style.letterSpacing = ls + 'em'; } let fs = 8; while (f.scrollWidth > f.clientWidth + 1 && fs > 6.5) { fs -= 0.25; f.style.fontSize = fs + 'pt'; } });
  m.remove(); })();</script>
<script>{% include 'rawfit.js' %}</script>
{% for f in deck.scripts or [] %}<script src="{{ f }}"></script>{% endfor %}
</body></html>
